<Application x:Class="Testica.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Testica"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#F4F7F5" />
        <SolidColorBrush x:Key="PanelBrush" Color="#EEF3F0" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#183C35" />
        <SolidColorBrush x:Key="BodyTextBrush" Color="#53635E" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#687870" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE4DE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#183C35" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5EFEA" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#56A884" />
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#315C4B" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#A45B3D" />
        <SolidColorBrush x:Key="DangerTextBrush" Color="#A44837" />
        <SolidColorBrush x:Key="BrandGoldBrush" Color="#F5C96B" />
        <Style x:Key="ElevatedCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#24382F" BlurRadius="14" ShadowDepth="3" Opacity="0.09" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
